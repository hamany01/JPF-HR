# --- إعدادات بوت تيليغرام وكود القنوات ---
# SECURITY FIX: Telegram Bot Token should NOT use VITE_ prefix.
# It should be server-side only (set in Vercel Environment Variables without VITE_ prefix).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- إعدادات Firebase ---
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# --- SECURITY FIX: Email domain whitelist for Google Login ---
# Comma-separated list of allowed email domains (leave empty to allow all, not recommended)
# Example: yourcompany.com,anothercompany.com
VITE_ALLOWED_EMAIL_DOMAINS=yourcompany.com

# --- SECURITY FIX: CORS Configuration ---
# Comma-separated list of allowed origins for API requests
# Example: https://jpf-hr.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=https://jpf-hr.vercel.app

# --- AI Agent (Ollama) ---
# عنوان خادم Ollama على VPS
OLLAMA_URL=http://187.77.66.234:11434
# اسم النموذج المثبت على Ollama
OLLAMA_MODEL=glm4:9b

# --- إعدادات عامة للمنصة ---
VITE_APP_NAME=HR and Legal Case Management System
VITE_APP_URL=https://jpf-hr.vercel.app
