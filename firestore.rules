rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data : null;
    }

    function hasRole(roles) {
      let data = getUserData();
      return isSignedIn() && data != null && data.role in roles;
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function isCompanyRole() {
      return hasRole(['admin', 'company_manager', 'assistant_manager']);
    }
    
    function isAnyStaff() {
      return hasRole(['admin', 'company_manager', 'assistant_manager', 'law_firm_manager', 'law_firm_assistant', 'sales_employee']);
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); 
      
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      // To prevent privilege escalation, don't allow setting role unless admin
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId && (request.resource.data.role == resource.data.role || !('role' in resource.data)));
    }

    // --- Roles Permissions Collection ---
    match /roles_permissions/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Cases Collection ---
    match /cases/{caseId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        hasRole(['company_manager', 'assistant_manager']) ||
        (hasRole(['sales_employee']) && resource.data.salesEmployeeId == request.auth.uid) ||
        (hasRole(['law_firm_manager']) && resource.data.lawFirmId != null && resource.data.lawFirmId == getUserData().lawFirmId) ||
        (hasRole(['law_firm_assistant']) && resource.data.assignedAssistantId == request.auth.uid)
      ) && (
        isAdmin() || resource.data.isDeleted != true
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        hasRole(['company_manager', 'assistant_manager']) ||
        (hasRole(['sales_employee']) && resource.data.salesEmployeeId == request.auth.uid) ||
        (hasRole(['law_firm_manager']) && resource.data.lawFirmId != null && resource.data.lawFirmId == getUserData().lawFirmId) ||
        (hasRole(['law_firm_assistant']) && resource.data.assignedAssistantId == request.auth.uid)
      ) && (
        isAdmin() || resource.data.isDeleted != true
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        hasRole(['company_manager', 'assistant_manager'])
      ) && (!('isDeleted' in request.resource.data) || request.resource.data.isDeleted != true);

      allow update: if isSignedIn() && (
        isAdmin() ||
        hasRole(['company_manager', 'assistant_manager']) ||
        (hasRole(['law_firm_manager']) && resource.data.lawFirmId != null && resource.data.lawFirmId == getUserData().lawFirmId) ||
        (hasRole(['law_firm_assistant']) && resource.data.assignedAssistantId == request.auth.uid)
      ) && (
        isAdmin() || resource.data.isDeleted != true
      );

      allow delete: if isSignedIn() && isAdmin();

      // Subcollections
      match /activities/{docId} {
        allow read: if isSignedIn();
        allow create, update: if isAnyStaff();
        allow delete: if isCompanyRole();
      }
      
      match /documents/{docId} {
        allow read: if isSignedIn();
        allow create, update: if isAnyStaff();
        allow delete: if isCompanyRole();
      }

      match /sessions/{docId} {
        allow read: if isSignedIn();
        allow create, update: if isAnyStaff();
        allow delete: if isCompanyRole();
      }

      match /payments/{docId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin() || hasRole(['company_manager', 'assistant_manager']);
      }
    }

    // --- Payment Plans Collection ---
    match /payment_plans/{planId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        hasRole(['company_manager', 'assistant_manager']) ||
        hasRole(['sales_employee', 'law_firm_manager', 'law_firm_assistant'])
      ) && (isAdmin() || resource.data.isDeleted != true);

      allow list: if isSignedIn() && (
        isAdmin() ||
        hasRole(['company_manager', 'assistant_manager']) ||
        hasRole(['sales_employee', 'law_firm_manager', 'law_firm_assistant'])
      ) && (isAdmin() || resource.data.isDeleted != true);

      allow create: if isSignedIn() && (
        isAdmin() ||
        hasRole(['company_manager', 'assistant_manager'])
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        hasRole(['company_manager', 'assistant_manager'])
      );

      allow delete: if isSignedIn() && isAdmin();
    }

    // --- Settings Collection ---
    match /settings/{settingId} {
      allow get: if settingId == 'appearance' || isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin();
      allow update: if isSignedIn() && settingId == 'sequences' && (isCompanyRole() || hasRole(['law_firm_manager']));
    }

    // --- Requests Collection ---
    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isCompanyRole() || hasRole(['law_firm_manager']);
      allow update: if hasRole(['admin', 'law_firm_manager', 'company_manager']) || (isCompanyRole() && resource.data.status == 'pending');
      allow delete: if isAdmin();

      match /notes/{noteId} {
        allow read: if isSignedIn() && (
          hasRole(['admin', 'law_firm_manager', 'company_manager', 'assistant_manager', 'law_firm_assistant']) ||
          resource.data.scope == 'employee_public' ||
          (resource.data.scope == 'employee_targeted' && resource.data.targetEmployeeId == request.auth.uid) ||
          resource.data.createdBy == request.auth.uid
        );
        
        allow create: if isSignedIn() && (
          hasRole(['admin', 'law_firm_manager', 'company_manager', 'assistant_manager', 'law_firm_assistant']) ||
          (hasRole(['sales_employee']) && 
           request.resource.data.scope == 'employee_public' &&
           request.resource.data.createdBy == request.auth.uid)
        );
        
        allow update, delete: if isSignedIn() && (
          hasRole(['admin']) || resource.data.createdBy == request.auth.uid
        );
      }
    }

    // --- Unified App Events Collection ---
    match /appEvents/{eventId} {
      allow read, create, update: if isSignedIn();
    }

    // --- Notification System ---
    match /notificationSettings/{document=**} {
      allow read, write: if isSignedIn() && isAdmin();
    }

    match /notificationRules/{ruleId} {
      allow read, write: if isSignedIn() && isAdmin();
    }

    match /notificationLogs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow create: if isSignedIn(); 
    }

    // --- Legacy Request Events Collection ---
    match /requestEvents/{eventId} {
      allow read, create, update: if isSignedIn();
    }

    // --- Case Sessions Collection (for Reminders) ---
    match /case_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isAnyStaff();
      allow update: if isSignedIn(); 
      allow delete: if isCompanyRole();
    }

    // --- Notifications Collection ---
    match /notifications/{notificationId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // --- Audit Logs Collection ---
    match /audit_logs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow write: if false; 
    }
  }
}
