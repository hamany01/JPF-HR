rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // SECURITY FIX: Comprehensive Firestore Security Rules
    // ============================================================
    
    // Allowed roles in the system
    function isValidRole(role) {
      return role in ['admin', 'company_manager', 'assistant_manager', 'sales_employee', 
                     'law_firm_manager', 'law_firm_assistant', 'law_manager', 
                     'law_assistant', 'company_assistant', 'employee'];
    }
    
    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserRole() in roles ||
          (getUserRole() == 'law_manager' && 'law_firm_manager' in roles)
        );
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function isCompanyManager() {
      return hasRole(['company_manager']);
    }
    
    function isLawManager() {
      return hasRole(['admin', 'law_firm_manager', 'law_manager']);
    }

    function isManager() {
      return hasRole(['admin', 'company_manager', 'assistant_manager']);
    }

    // --- Users Collection ---
    // SECURITY FIX: Users can only read their OWN profile. Admins can read all.
    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId 
        && isValidRole(request.resource.data.role)
        && request.resource.data.role == 'employee'
        && request.resource.data.isActive == false;
      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == userId && 
         // Users cannot change their own role
         (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
         // Users cannot activate themselves
         (!('isActive' in request.resource.data) || request.resource.data.isActive == resource.data.isActive)
        )
      );
      allow delete: if isAdmin();
    }

    // --- Roles Permissions Collection ---
    match /roles_permissions/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Cases Collection ---
    match /cases/{caseId} {
      // SECURITY FIX: Role-based read access instead of "any signed-in user"
      allow read: if isSignedIn() && (
        isAdmin() ||
        isManager() ||
        (isCompanyManager() && (resource.data.requestCreatedBy == request.auth.uid || resource.data.createdBy == request.auth.uid || !('requestCreatedBy' in resource.data))) ||
        (isLawManager() && resource.data.lawFirmId == 'LAW-JPF-001') ||
        (hasRole(['sales_employee']) && resource.data.salesEmployeeId == request.auth.uid) ||
        (hasRole(['law_firm_assistant']) && resource.data.assignedAssistantId == request.auth.uid)
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        isLawManager()
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (isLawManager() && resource.data.lawFirmId == 'LAW-JPF-001' && (
          // Lock document edits once the case is closed
          resource.data.status != 'closed' || isAdmin()
        ))
      );

      allow delete: if isSignedIn() && isAdmin();

      // Subcollections under Cases — SECURITY FIX: Same role-based access as parent case
      match /activities/{docId} {
        allow read: if isSignedIn() && (
          isAdmin() || isManager() ||
          (isLawManager() && get(/databases/$(database)/documents/cases/$(caseId)).data.lawFirmId == 'LAW-JPF-001') ||
          (hasRole(['sales_employee']) && get(/databases/$(database)/documents/cases/$(caseId)).data.salesEmployeeId == request.auth.uid) ||
          (hasRole(['law_firm_assistant']) && get(/databases/$(database)/documents/cases/$(caseId)).data.assignedAssistantId == request.auth.uid)
        );
        allow create, update: if isAdmin() || (isLawManager() && get(/databases/$(database)/documents/cases/$(caseId)).data.status != 'closed');
        allow delete: if isAdmin();
      }
      
      match /documents/{docId} {
        allow read: if isSignedIn() && (
          isAdmin() || isManager() ||
          (isLawManager() && get(/databases/$(database)/documents/cases/$(caseId)).data.lawFirmId == 'LAW-JPF-001') ||
          (hasRole(['sales_employee']) && get(/databases/$(database)/documents/cases/$(caseId)).data.salesEmployeeId == request.auth.uid) ||
          (hasRole(['law_firm_assistant']) && get(/databases/$(database)/documents/cases/$(caseId)).data.assignedAssistantId == request.auth.uid)
        );
        allow create, update: if isAdmin() || (isLawManager() && get(/databases/$(database)/documents/cases/$(caseId)).data.status != 'closed');
        allow delete: if isAdmin();
      }

      match /sessions/{docId} {
        allow read: if isSignedIn() && (
          isAdmin() || isManager() ||
          (isLawManager() && get(/databases/$(database)/documents/cases/$(caseId)).data.lawFirmId == 'LAW-JPF-001') ||
          (hasRole(['sales_employee']) && get(/databases/$(database)/documents/cases/$(caseId)).data.salesEmployeeId == request.auth.uid) ||
          (hasRole(['law_firm_assistant']) && get(/databases/$(database)/documents/cases/$(caseId)).data.assignedAssistantId == request.auth.uid)
        );
        allow create, update: if isAdmin() || (isLawManager() && get(/databases/$(database)/documents/cases/$(caseId)).data.status != 'closed');
        allow delete: if isAdmin();
      }

      match /payments/{docId} {
        allow read: if isSignedIn() && (
          isAdmin() || isManager() ||
          (isLawManager() && get(/databases/$(database)/documents/cases/$(caseId)).data.lawFirmId == 'LAW-JPF-001') ||
          (hasRole(['sales_employee']) && get(/databases/$(database)/documents/cases/$(caseId)).data.salesEmployeeId == request.auth.uid) ||
          (hasRole(['law_firm_assistant']) && get(/databases/$(database)/documents/cases/$(caseId)).data.assignedAssistantId == request.auth.uid)
        );
        allow create, update, delete: if isAdmin() || (isLawManager() && get(/databases/$(database)/documents/cases/$(caseId)).data.status != 'closed');
      }
    }

    // --- Payment Plans Collection ---
    match /payment_plans/{planId} {
      allow read: if isSignedIn() && (isAdmin() || isManager() || isLawManager());
      allow create, update: if isAdmin() || (isLawManager() && (
        !exists(/databases/$(database)/documents/cases/$(request.resource.data.caseId)) ||
        get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.status != 'closed'
      ));
      allow delete: if isSignedIn() && isAdmin();
    }

    // --- Settings Collection ---
    match /settings/{settingId} {
      allow get: if settingId == 'appearance' || isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin();
      allow update: if isSignedIn() && settingId == 'sequences' && (isCompanyManager() || isLawManager());
    }

    // --- Counters Collection ---
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isAdmin() || isLawManager() || isCompanyManager());
    }

    // --- Requests Collection ---
    match /requests/{requestId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isCompanyManager() && resource.data.createdBy == request.auth.uid) ||
        isLawManager()
      );
      
      allow create: if isSignedIn() && (
        isAdmin() ||
        isCompanyManager()
      );
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isCompanyManager() && resource.data.createdBy == request.auth.uid && resource.data.status == 'pending_law_review') ||
        (isLawManager() && (
          resource.data.status == 'pending_law_review' && (
            !('lawFirmId' in resource.data) || 
            resource.data.lawFirmId == 'LAW-JPF-001'
          )
        ))
      );
      
      allow delete: if isSignedIn() && isAdmin();

      match /notes/{noteId} {
        allow read: if isSignedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
        allow create: if isSignedIn() && (isLawManager() || isCompanyManager());
        allow update, delete: if isSignedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
      }
    }

    // --- Unified App Events Collection ---
    // SECURITY FIX: Events can only be read by managers/admins, not any signed-in user
    match /appEvents/{eventId} {
      allow read: if isSignedIn() && (isAdmin() || isManager() || isLawManager());
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Notification System ---
    match /notificationSettings/{document=**} {
      allow read, write: if isSignedIn() && isAdmin();
    }

    match /notificationRules/{ruleId} {
      allow read, write: if isSignedIn() && isAdmin();
    }

    match /notificationLogs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow create: if isSignedIn(); 
    }

    // --- Legacy Request Events Collection ---
    // SECURITY FIX: Restricted to managers/admins
    match /requestEvents/{eventId} {
      allow read: if isSignedIn() && (isAdmin() || isManager() || isLawManager());
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }

    // --- Case Sessions Collection ---
    match /case_sessions/{sessionId} {
      allow read: if isSignedIn() && (isAdmin() || isManager() || isLawManager());
      allow create, update: if isAdmin() || isLawManager();
      allow delete: if isAdmin();
    }

    // --- Notifications Collection ---
    // SECURITY FIX: Users can only read/update/delete their OWN notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // --- Audit Logs Collection ---
    match /audit_logs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow write: if false; 
    }
  }
}